    <ui:FluentWindow
   x:Class="DWHelperUI.EditConfigForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DW Helper UI"
 
    xmlns:xaml="clr-namespace:DWHelperUI"
        xmlns:props="clr-namespace:DWHelperUI.Properties" xmlns:System="clr-namespace:System;assembly=System.Runtime"
Width="1150" Height="790" MinWidth="700" MinHeight="400"
    d:DesignHeight="1100"
        Closing="Window_Closing"
    d:DesignWidth="1150"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">


    <ui:FluentWindow.Resources>
        <!-- The DataGrid column editors fall back to the framework default look, so re-apply the Fluent styles. -->
        <Style x:Key="ConfigComboBoxDisplay" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ConfigComboBoxEdit" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

        <Style x:Key="ConfigCheckBoxDisplay" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="ConfigCheckBoxEdit" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConfigDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="MinColumnWidth" Value="120"/>
            <Setter Property="MaxHeight" Value="320"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar FontWeight="Bold" FontSize="16"
Title="Modify Configuration"
Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20 0 20 0">
            <StackPanel Orientation="Vertical" Margin="0 10 0 20">

                <ui:CardExpander Margin="0 0 0 12" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <TextBlock Text="Application settings" FontSize="14" FontWeight="SemiBold"/>
                    </ui:CardExpander.Header>
                    <DataGrid x:Name="appSettings" Style="{StaticResource ConfigDataGrid}" IsReadOnly="False" CanUserAddRows="false" BeginningEdit="dataGrid_BeginningEdit" CellEditEnding="dataGrid_CellEditEnding"/>
                </ui:CardExpander>

                <ui:CardExpander Margin="0 0 0 12" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <TextBlock Text="ADO Wiki upload settings" FontSize="14" FontWeight="SemiBold"/>
                    </ui:CardExpander.Header>
                    <DataGrid x:Name="adoSettings" Style="{StaticResource ConfigDataGrid}" IsReadOnly="False" CanUserAddRows="false" BeginningEdit="dataGrid_BeginningEdit" CellEditEnding="dataGrid_CellEditEnding"/>
                </ui:CardExpander>

                <ui:CardExpander Margin="0 0 0 12" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <TextBlock Text="Solutions" FontSize="14" FontWeight="SemiBold"/>
                    </ui:CardExpander.Header>
                    <DataGrid x:Name="solutions" Style="{StaticResource ConfigDataGrid}" IsReadOnly="False" CanUserAddRows="true" BeginningEdit="dataGrid_BeginningEdit" CellEditEnding="dataGrid_CellEditEnding"/>
                </ui:CardExpander>

                <ui:CardExpander Margin="0 0 0 12" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <TextBlock Text="Groups" FontSize="14" FontWeight="SemiBold"/>
                    </ui:CardExpander.Header>
                    <DataGrid x:Name="groups" Style="{StaticResource ConfigDataGrid}" IsReadOnly="False" CanUserAddRows="true" BeginningEdit="dataGrid_BeginningEdit" CellEditEnding="dataGrid_CellEditEnding"/>
                </ui:CardExpander>

                <ui:CardExpander Margin="0 0 0 12" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <TextBlock Text="Map configs" FontSize="14" FontWeight="SemiBold"/>
                    </ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0 0 0 10">
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0 0 8 0" FontSize="13"/>
                            <TextBox Name="SearchString" Width="240" VerticalAlignment="Center" ToolTip="Filter the map configs on any value"/>
                            <Button Content="Filter" Margin="8 0 0 0" MinWidth="80" Click="Filter_Click"/>
                            <Button Content="Clear" Margin="8 0 0 0" MinWidth="80" Click="ClearFilter_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="mapConfig" Grid.Row="1" Grid.Column="0" Style="{StaticResource ConfigDataGrid}" IsReadOnly="False"
                                  MaxHeight="420" CanUserSortColumns="False" BeginningEdit="dataGrid_BeginningEdit" CellEditEnding="dataGrid_CellEditEnding"/>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="12 0 0 0">
                            <Button Name="moveUp" MinWidth="110" Margin="0 0 0 8" Content="Move Up" Padding="5" Click="moveUp_Click"/>
                            <Button Name="moveDown" MinWidth="110" Content="Move Down" Padding="5" Click="moveDown_Click"/>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20 12">
                <Button x:Name="SaveSettings" MinWidth="140" Click="SaveSettings_Click" Content="Save Settings"/>
            </StackPanel>
        </Border>
    </Grid>

</ui:FluentWindow>
